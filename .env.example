# ===== Infrastructure only. NO API keys are stored here. =====
# Claude/OpenAI/DeepSeek/GigaChat keys and Pachca/Omnidesk tokens are entered later,
# in the admin panel's Settings tab. Only ADMIN_PASSWORD and SESSION_SECRET matter here.

# Port the service listens on
PORT=8746

# Where to store data (knowledge base files, database, vector index, model cache).
# Leave this unset — each deployment path already picks the right default on its own:
# the Docker image defaults to /data (the declared volume), a bare-metal/systemd run
# defaults to <repo>/data. Setting it here would override BOTH with the same path,
# which is wrong for whichever one you're not using — most likely to bite in Docker,
# writing into the container's throwaway filesystem instead of the mounted volume.
# DATA_DIR=./data

# Embedding model: e5-base (~4 GB RAM) or e5-large (~8 GB RAM, more accurate)
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Admin panel login
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=generate-a-random-value-here

# Optional: encrypts API keys/tokens stored via the admin panel. Leave empty to store
# them as plain text in SQLite (fine for a trusted single-user server).
ENCRYPTION_KEY=

# Telegram and WhatsApp tokens are NOT set here — they're entered in the admin
# panel's Settings tab, same as everything else. See README "Connecting messaging
# channels" for the setup steps.

# Only used by "docker compose up" (Caddy service — see docker-compose.yml).
# A real domain -> Caddy issues an HTTPS certificate automatically.
# ":80" -> plain HTTP, no certificate (fine for a local/test box).
DOMAIN=:80
