# ===== Только инфраструктура. API-КЛЮЧИ ЗДЕСЬ НЕ ХРАНЯТСЯ =====
# Ключ Claude и токены Пачки вводятся в админ-панели → «Настройки».
# install.sh создаёт .env сам и генерирует SESSION_SECRET. Вручную поменяйте только ADMIN_PASSWORD.

# Порт веб-сервиса (заведомо свободный)
PORT=8745

# Где хранить данные (файлы БЗ, база, индекс, кэш модели)
DATA_DIR=/opt/kb-agent/data

# Модель эмбеддингов: e5-base (4 ГБ RAM) или e5-large (8 ГБ RAM, точнее)
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Вход в админ-панель
ADMIN_PASSWORD=поменяйте-этот-пароль
SESSION_SECRET=будет-сгенерирован-скриптом-установки
