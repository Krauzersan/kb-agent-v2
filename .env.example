# ===== Infrastructure only. NO API keys are stored here. =====
# Claude/OpenAI/DeepSeek/GigaChat keys and Pachca/Omnidesk tokens are entered later,
# in the admin panel's Settings tab. Only ADMIN_PASSWORD and SESSION_SECRET matter here.

# Port the service listens on
PORT=8746

# Where to store data (knowledge base files, database, vector index, model cache)
DATA_DIR=./data

# Embedding model: e5-base (~4 GB RAM) or e5-large (~8 GB RAM, more accurate)
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Admin panel login
ADMIN_PASSWORD=change-this-password
SESSION_SECRET=generate-a-random-value-here

# Optional: encrypts API keys/tokens stored via the admin panel. Leave empty to store
# them as plain text in SQLite (fine for a trusted single-user server).
ENCRYPTION_KEY=

# ===== Messaging channels (optional, basic integration) =====
# Unlike Claude/Pachca/Omnidesk these aren't in the admin UI yet — set them here and
# restart. See README "Connecting messaging channels" for how to obtain each value.

# Telegram: token from @BotFather
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API (Meta): permanent access token + Phone Number ID from
# developers.facebook.com, and a verify token you make up yourself (Meta echoes it
# back during the webhook handshake).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
