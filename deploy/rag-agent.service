[Unit]
Description=RAG Agent - ассистент базы знаний (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/rag-agent/app
EnvironmentFile=/opt/rag-agent/.env
ExecStart=/opt/rag-agent/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8746
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
