[Unit]
Description=KB Agent - ассистент базы знаний (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/kb-agent/app
EnvironmentFile=/opt/kb-agent/.env
# Порт 8745 — заведомо свободный. Чтобы сменить — поправьте здесь и перезапустите.
ExecStart=/opt/kb-agent/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8745
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
