[Unit]
Description=KB Agent v2 - ассистент базы знаний (тестовая копия, FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/kb-agent-v2/app
EnvironmentFile=/opt/kb-agent-v2/.env
ExecStart=/opt/kb-agent-v2/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8746
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
