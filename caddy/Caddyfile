# Optional reverse proxy example — not required to run the app.
#
# Site address comes from the DOMAIN env var:
#   - a real domain (kb.example.com) -> Caddy issues an HTTPS certificate automatically
#   - ":80" -> plain HTTP, no certificate (fine for quick local tests)
#
# Point "reverse_proxy" at wherever the container's PORT is published, e.g.
# "localhost:8746" if you ran the container with "-p 8746:8746".
{$DOMAIN} {
	encode gzip

	# Allow large file uploads to the knowledge base
	request_body {
		max_size 50MB
	}

	reverse_proxy localhost:8746
}
