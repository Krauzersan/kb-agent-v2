# Used by "docker compose up" (see docker-compose.yml at the repo root) — Caddy
# terminates HTTPS and forwards to the app container over the compose network.
#
# Site address comes from the DOMAIN env var (set it in .env):
#   - a real domain (kb.example.com) -> Caddy issues an HTTPS certificate automatically
#   - ":80" -> plain HTTP, no certificate (fine for quick local tests)
#
# Running the app container standalone instead of via compose? Point "reverse_proxy"
# at "localhost:8746" (or wherever PORT is published) instead of "app:8746".
{$DOMAIN} {
	encode gzip

	# Allow large file uploads to the knowledge base
	request_body {
		max_size 50MB
	}

	reverse_proxy app:8746
}
